FROM rustlang/rust:nightly-trixie-slim AS chef
WORKDIR /empath

RUN apt update && apt install -y git clang mold

ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_UNSTABLE_SPARSE_REGISTRY=true
ENV CARGO_INCREMENTAL=0

RUN cargo +nightly install cargo-chef

FROM chef AS planner
COPY . .
RUN cargo +nightly chef prepare --recipe-path recipe.json

FROM chef AS empath
COPY --from=planner /empath/recipe.json recipe.json
RUN cargo +nightly chef cook --release --recipe-path recipe.json

ENV RUSTUP_PERMIT_COPY_RENAME=true
RUN rustup target add wasm32-wasip2
RUN cargo install cargo-xtask

RUN apt-get update && apt-get install -y libpython3.13-dev

COPY . .
RUN RUSTFLAGS="-C linker=clang -C link-arg=-fuse-ld=/usr/bin/mold" cargo +nightly build --release

# Install gcc for building example modules
RUN apt update && apt install -y gcc && rm -rf /var/lib/apt/lists/*

# Build all example modules (C, WASM, Python) using xtask
RUN cargo xtask build-all

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y libpython3.13-dev

WORKDIR /empath

# Copy empath binaries
COPY --from=empath /empath/target/release/empath .
COPY --from=empath /empath/target/release/empathctl .
COPY --from=empath /empath/target/release/empathcfg .

# Copy empath shared library (required by FFI modules)
COPY --from=empath /empath/target/release/libempath.so /usr/local/lib/

# Copy all built example modules from target/modules/
COPY --from=empath /empath/target/modules/* /empath/modules/

# Update library cache so modules can find libempath.so
RUN ldconfig /empath/modules/

VOLUME /config

ENV LOG_LEVEL="info"
ENV LD_LIBRARY_PATH="/empath/modules:${LD_LIBRARY_PATH}"

ENTRYPOINT [ "bash", "--login", "-c" ]

CMD [ "/empath/empath" ]
